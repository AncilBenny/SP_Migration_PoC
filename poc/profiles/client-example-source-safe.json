{
  "version": "1.0",
  "id": "client-resource-portal-source-safe",
  "components": {
    "hero": "pageHeader",
    "richText": "contentBody",
    "image": "media",
    "linkList": "resourceCards",
    "unknown": "reviewNote"
  },
  "colors": {
    "primary": "#263e52",
    "background": "#f2f4f5",
    "surface": "#ffffff",
    "text": "#24323d",
    "link": "#176a87"
  },
  "layout": {
    "maxWidthPx": 1080,
    "gapPx": 28
  },
  "font": "system",
  "labels": {
